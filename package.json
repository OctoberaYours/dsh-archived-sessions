{
  "name": "dsh-archived-sessions",
  "version": "0.2.0",
  "description": "DSH web plugin: an Archived Sessions manager in Settings — browse archived conversations, expand per-session details (disk usage, downloads, tool usage, lineage, cross-session recall), multi-select and permanently delete. Maintained fork targeting DSH 0.1.7-rc.2.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "author": "OctoberaYours",
  "contributors": [
    {
      "name": "Zephyr-vibe",
      "url": "https://github.com/Zephyr-vibe/dsh-archived-sessions"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/OctoberaYours/dsh-archived-sessions.git"
  },
  "bugs": {
    "url": "https://github.com/OctoberaYours/dsh-archived-sessions/issues"
  },
  "homepage": "https://github.com/OctoberaYours/dsh-archived-sessions#readme",
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-session-persistence": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-workspace": "^0.1.7-rc.2",
    "react": "^18.2.0"
  },
  "optionalPeerDependencies": {
    "@deepseek-ai/dsh-agent-loop": "^0.1.7-rc.2"
  },
  "files": [
    "lib/**/*.js",
    "!lib/*.bak-*",
    "!lib/**/*.bak-*",
    "cordis.patch.yml",
    "README.md",
    "USAGE.md",
    "docs",
    "LICENSE",
    "package.json"
  ]
}
